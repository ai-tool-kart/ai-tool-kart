# AI Tool Kart — News Agent environment.
#
# Copy to `agent/.env` and fill in. `.env` is gitignored; this file is the only
# tracked env file and must never contain a real value.
#
# Every variable here is SERVER-SIDE ONLY. Never prefix any of these with VITE_
# and never copy them into client/.env.local — that file is compiled into the
# public browser bundle. See NEWS_AGENT.md §28.

# ─── LLM provider ────────────────────────────────────────────────────────────
# `mock`   deterministic offline provider used by tests and dry runs. No network
#          calls, no key, no cost.
# `openai` live provider, via the Responses API with strict Structured Outputs.
#
# Anything other than `mock` requires LLM_API_KEY; the agent refuses to start
# without one. Verify a provider before spending a run with:
#   npm run agent -- --llm-check
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional per-task model overrides. Cheap model for classification/extraction,
# stronger model for writing/editing; the task -> class mapping lives in
# src/config/limits.ts (TASK_MODEL_CLASS).
# Leave blank to use the adapter defaults. For `openai` those are:
#   fast   = gpt-4.1-mini   (classifier, fact extractor)
#   strong = gpt-4.1        (verifier, writer, editor)
# Both are non-reasoning models on purpose: TASK_MAX_OUTPUT_TOKENS budgets the
# answer, and on a reasoning model that same ceiling also has to cover hidden
# reasoning tokens, which truncates responses instead of making them cheaper.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# ─── WordPress (write path) ──────────────────────────────────────────────────
# Base REST URL including the namespace, e.g. https://cms.example.com/wp-json/wp/v2
# Must be HTTPS unless it is a loopback/.local development host.
WORDPRESS_API_URL=
# Dedicated least-privilege user — NOT an administrator. See NEWS_AGENT.md §17.
WORDPRESS_USERNAME=
# WordPress Application Password (Users → Profile → Application Passwords).
# Spaces are permitted and are stripped automatically.
WORDPRESS_APP_PASSWORD=
# Create WordPress category/tag terms when they do not exist yet.
WORDPRESS_CREATE_TERMS=true

# ─── Storage ─────────────────────────────────────────────────────────────────
AGENT_DB_PATH=./data/news-agent.sqlite

# ─── Publishing policy ───────────────────────────────────────────────────────
# MUST remain false. Automatic publishing is Phase I (NEWS_AGENT.md §19) and is
# not implemented; the agent refuses to start if this is true.
AGENT_AUTO_PUBLISH=false

# ─── Cost controls (NEWS_AGENT.md §27) ───────────────────────────────────────
# Semantics for every cap below:
#   unset / blank  -> the documented default shown here
#   0              -> ZERO WORK. A valid, supported value: the run defers the
#                     remaining work and exits cleanly. Useful for exercising
#                     ingestion, dedupe and the pending-publication retry
#                     without spending a token.
#   anything else invalid (negative, fractional, non-numeric)
#                  -> startup FAILS with a message naming the variable.
#
# A cap is never silently replaced by its default. An earlier version did
# exactly that: setting a cap to 0 produced the full default workload instead of
# a no-op, so a cost control failed OPEN at the moment it was being tightened.
#
# Note that zeroing every cap does not make a run do nothing — publishing an
# article an earlier run already approved costs no LLM budget and still happens.
AGENT_MAX_ITEMS_PER_SOURCE_PER_RUN=25
AGENT_MAX_CANDIDATES_PER_RUN=20
AGENT_MAX_STORIES_VERIFIED_PER_RUN=5
AGENT_MAX_ARTICLES_PER_RUN=2
AGENT_MAX_LLM_CALLS_PER_RUN=60
AGENT_MAX_TOKENS_PER_RUN=250000

# ─── Selection threshold ─────────────────────────────────────────────────────
# Weighted score (0–10) a story must reach to earn evidence gathering.
AGENT_MIN_WEIGHTED_SCORE=6

# ─── Networking ──────────────────────────────────────────────────────────────
AGENT_HTTP_TIMEOUT_MS=15000
AGENT_MAX_RESPONSE_BYTES=2500000
AGENT_USER_AGENT=AIToolKartNewsAgent/0.1 (+https://aitoolkart.com)

# ─── Run lock (NEWS_AGENT.md §23) ────────────────────────────────────────────
AGENT_RUN_LOCK_STALE_MINUTES=30

# ─── Logging ─────────────────────────────────────────────────────────────────
# json = one structured object per line (production). pretty = human-readable.
AGENT_LOG_FORMAT=pretty
AGENT_LOG_LEVEL=info
