# ─────────────────────────────────────────────────────────────────────────────
# News Agent — DEMO DASHBOARD overrides
#
# Loaded by `npm run demo` AFTER .env, so every value here WINS over .env.
# That is the whole point: .env may legitimately point the operational agent at
# the production CMS, and the demo must never inherit that.
#
# Copy to .env.demo and fill in. .env.demo is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ---- LOCAL WordPress (required for a publishing demo) ----------------------
# Must be a local development host (localhost, 127.0.0.1, *.local, *.localhost,
# *.test). The dashboard REFUSES to run the pipeline against anything else.
WORDPRESS_API_URL=http://ai-tool-kart-cms.local/wp-json/wp/v2

# A user on the LOCAL WordPress with the Author role (not an administrator),
# and an Application Password generated for that user
# (Users -> Profile -> Application Passwords).
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ---- Isolated demo database ------------------------------------------------
# CRITICAL: keep this separate from AGENT_DB_PATH in .env. The two runs share a
# queue of approved-but-unpublished drafts, so a demo article left in the
# operational database would be published to PRODUCTION by the next
# `npm run agent`.
AGENT_DB_PATH=./data/news-agent-demo.sqlite

# ---- Demo run caps ---------------------------------------------------------
# One article per run keeps a live demo short and cheap. Raise only if needed.
AGENT_MAX_ARTICLES_PER_RUN=1
AGENT_MAX_STORIES_VERIFIED_PER_RUN=2
AGENT_MAX_CANDIDATES_PER_RUN=12

# ---- Demo server -----------------------------------------------------------
# Port the dashboard API listens on (127.0.0.1 only). Default 4317.
NEWS_AGENT_DEMO_PORT=4317
