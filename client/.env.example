# AI Tool Kart — Client environment.
#
# Copy to `client/.env.local` and adjust. `.env.local` is gitignored (`*.local`);
# this file is the only tracked client env file.
#
# ── EVERYTHING HERE IS PUBLIC ────────────────────────────────────────────────
#
# Vite compiles every VITE_-prefixed variable into the browser bundle, in plain
# text, for anyone to read. A secret placed here is a published secret.
#
# So there is no VITE_LLM_API_KEY, no VITE_ANTHROPIC_API_KEY and no
# VITE_OPENAI_API_KEY, and there never will be: the browser talks only to the
# AI Tool Kart backend, and the backend is the only process that ever holds a
# model credential (see server/.env.example, LLM_API_KEY).

# ─── The AI Tool Kart API ────────────────────────────────────────────────────
# Base URL the BROWSER uses for the API, INCLUDING the /api path. Read once at
# module scope by src/services/http.ts, which every service module goes through.
#
# Default and recommended: the same-origin path /api.
#   development  vite.config.ts proxies /api to http://localhost:3001
#                (override the target with VITE_DEV_API_PROXY)
#   production   the Vercel /api rewrite forwards it to Railway
# Accounts (the HttpOnly session cookie) only work same-origin. An absolute,
# cross-origin URL still works for everything public, but signed-out only.
VITE_API_URL=/api

# ─── Prerender build only ────────────────────────────────────────────────────
# `npm run build:prerendered` fetches guides from Node at BUILD time, so it
# needs an absolute URL — separate from the browser's VITE_API_URL above.
# Falls back to an absolute VITE_API_URL, then to http://localhost:3001/api.
# PRERENDER_API_URL=https://<railway-host>/api

# ─── The public site URL ─────────────────────────────────────────────────────
# The origin the site is served from, no trailing slash (e.g.
# https://aitoolkart.com). Canonical links, og:url and structured data are
# built from it. REQUIRED by `npm run build:prerendered`, which refuses to run
# without it; in development the page falls back to the current origin.
VITE_SITE_URL=

# ─── WordPress (blog content) ────────────────────────────────────────────────
# The headless CMS behind /blog. REQUIRED — services/wordpress.ts throws when it
# is missing rather than guessing someone else's host. The blog pages degrade to
# an error state; the rest of the site is unaffected.
VITE_WORDPRESS_API_URL=http://ai-tool-kart-cms.local/wp-json/wp/v2
