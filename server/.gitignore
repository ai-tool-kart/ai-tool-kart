# Dependencies
node_modules/

# Secrets — never commit. .env.example is the only tracked env file.
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Build output
dist/
coverage/

scripts/data/

# Submissions store (JSON-file backend, SPEC-submit-backend.md §3) — the
# real data file is not tracked. data/submissions.example.json ships
# instead, so a fresh clone still works.
data/submissions.json

# OS
.DS_Store

# Prisma client — generated by `npm run db:generate` (runs on install).
src/generated/

# Local backups and pre-import snapshots (npm run db:backup, db:import).
backups/
